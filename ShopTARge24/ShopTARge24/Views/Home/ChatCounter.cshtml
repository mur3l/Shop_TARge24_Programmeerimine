<h3>Chat:</h3>

<div id="messagesList"
     style="height:250px; overflow-y:auto; border:1px solid #ccc; padding:10px; margin-bottom:15px;">
</div>

<div class="input-group mb-2">
    <span class="input-group-text">Name</span>
    <input id="userInput" type="text" class="form-control" placeholder="Enter your name..." />
</div>

<div class="input-group mb-3">
    <span class="input-group-text">Message</span>
    <input id="messageInput" type="text" class="form-control" placeholder="Type message..." />
</div>

<button id="sendButton" class="btn btn-primary">Send Message</button>

<h3>Users:</h3>

<div class="container mb-4">
    <div class="row mb-2">
        <div class="col-3 fw-bold">Total Views:</div>
        <div class="col-4">
            <span id="totalViewsCounter"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-3 fw-bold">Total Users Online:</div>
        <div class="col-4">
            <span id="totalUsersCounter"></span>
        </div>
    </div>
</div>

<script src="~/js/signalr.js"></script>
<script src="~/js/usersCount.js"></script>
<script src="~/js/chat.js"></script>
